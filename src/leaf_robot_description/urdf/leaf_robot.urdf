<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed URDF with proper base link and cleaner hierarchy -->

<robot name="leaf_robot_description">

<material name="gray">
  <color rgba="0.7451 0.73725 0.72941 1"/>
</material>

<material name="green">
  <color rgba="0 1 0 1"/>
</material>

  <!-- ================= BASE FOOTPRINT ================= -->
  <link name="base_footprint"/>

  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.064016 -0.080031 0.11562" rpy="0 0 0"/>
      <mass value="1.1031"/>
      <inertia
        ixx="0.0023261"
        ixy="0.0001122"
        ixz="-1.4598E-06"
        iyy="0.0023583"
        iyz="5.3023E-06"
        izz="0.0024963"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/BASE.STL"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7451 0.73725 0.72941 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/BASE.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- FIXED ROOT JOINT -->
  <joint name="base_fixed_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.6" rpy="0 0 3.14"/>
  </joint>

  <!-- ================= LINK J1 ================= -->
  <link name="J_1">
    <inertial>
      <origin xyz="0.0030632 -0.00037054 0.19009" rpy="0 0 0"/>
      <mass value="1.089"/>
      <inertia
        ixx="0.0018485"
        ixy="-1.4598E-06"
        ixz="-0.00011196"
        iyy="0.0024341"
        iyz="-5.3023E-06"
        izz="0.001692"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_1.STL"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ROT_1" type="revolute">
    <origin xyz="-0.067 -0.065 0.082" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="J_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- ================= LINK J2 ================= -->
  <link name="J_2">
    <inertial>
      <origin xyz="-0.25856 0.13854 0.13905" rpy="0 0 0"/>
      <mass value="0.721"/>
      <inertia
        ixx="0.0019755"
        ixy="0.0020808"
        ixz="-3.9585E-06"
        iyy="0.004707"
        iyz="1.0786E-06"
        izz="0.00632"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_2.STL"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_2.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="PITCH_1" type="revolute">
    <origin xyz="0 -0.046 0.194" rpy="1.5708 1.0472 -3.1416"/>
    <parent link="J_1"/>
    <child link="J_2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <!-- ================= LINK J3 ================= -->
  <link name="J_3">
    <inertial>
      <origin xyz="0.15412 -0.0055136 0.088982" rpy="0 0 0"/>
      <mass value="0.21768"/>
      <inertia
        ixx="0.0012955"
        ixy="7.1563E-06"
        ixz="-0.0018514"
        iyy="0.0047078"
        iyz="4.1274E-06"
        izz="0.0034333"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_3.STL"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_3.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="PITCH_2" type="revolute">
    <origin xyz="-0.37152 0.2145 0.107" rpy="1.5708 0 -3.1416"/>
    <parent link="J_2"/>
    <child link="J_3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- ================= LINK J4 ================= -->
  <link name="J_4">
    <inertial>
      <origin xyz="0.0015946 0.0041989 -0.028525" rpy="0 0 0"/>
      <mass value="0.2071"/>
      <inertia
        ixx="0.00034764"
        ixy="1.6788E-07"
        ixz="-4.447E-08"
        iyy="0.00034785"
        iyz="-2.7415E-07"
        izz="0.00030028"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_4.STL"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_4.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="PITCH_3" type="revolute">
    <origin xyz="0.3542 0.012 0.2045" rpy="1.5708 0.68579 0"/>
    <parent link="J_3"/>
    <child link="J_4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- ================= LINK J5 ================= -->
  <link name="J_5">
    <inertial>
      <origin xyz="-0.0015905 -0.0042271 -0.028525" rpy="0 0 0"/>
      <mass value="0.2071"/>
      <inertia
        ixx="0.00034764"
        ixy="1.6788E-07"
        ixz="1.2854E-07"
        iyy="0.00034785"
        iyz="1.8355E-07"
        izz="0.00030028"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_5.STL"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leaf_robot_description/meshes/J_5.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ROT_2" type="revolute">
    <origin xyz="0.023514 0.062204 -0.0725" rpy="-1.5708 -2.7802 2.7802"/>
    <parent link="J_4"/>
    <child link="J_5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- ================= LINK J6 ================= -->
  <joint name="ROT_3" type="revolute">
    <parent link="J_5"/>
    <child link="J_6"/>
    <origin xyz="-0.0015905 -0.0042271 -0.078525" rpy="0 0 -0.353599"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" velocity="1.0" lower="-6.28" upper="6.28"/>
  </joint>

  <link name="J_6">
    <visual>
      <geometry><cylinder length="0.1" radius="0.03"/></geometry>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.02 0.02"/></geometry>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    </collision>
  </link>

  <!-- ========================= -->
  <!-- GRIPPER BASE -->
  <!-- ========================= -->

  <joint name="Gripper" type="fixed">
    <parent link="J_6"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 -0.06 0" rpy="1.5708 0 0"/>
  </joint>

  <link name="gripper_base_link">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.02"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <!-- LEFT FINGER -->

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger"/>
    <origin xyz="0 0.025 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.02"
           effort="10" velocity="0.1"/>
  </joint>

  <link name="left_finger">
    <visual>
      <geometry>
        <box size="0.02 0.01 0.235"/>
      </geometry>
      <origin xyz="0 0 0.1175"/>
      <material name="green"/>
    </visual>
  </link>

    <!-- RIGHT FINGER -->

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger"/>
    <origin xyz="0 -0.025 0"/>
    <axis xyz="0 -1 0"/>
    <mimic joint="left_finger_joint" multiplier="-1.0"/>
    <limit lower="0.0" upper="0.02"
          effort="10" velocity="0.1"/>
  </joint>

  <link name="right_finger">
    <visual>
      <geometry>
        <box size="0.02 0.01 0.235"/>
      </geometry>
      <origin xyz="0 0 0.1175"/>
      <material name="green"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.02 0.01 0.235"/>
      </geometry>
      <origin xyz="0 0 0.1175"/>
    </collision>
  </link>

  <!-- TCP -->

  <link name="link_tcp">
    <visual>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="green"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
  </link>

  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="link_tcp"/>
    <origin xyz="0 0 0.17625" rpy="0 0 0"/>
  </joint>
</robot>  