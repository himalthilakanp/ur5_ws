<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="leaf_robot_description">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import leaf_robot_description urdf file -->
    <xacro:include filename="$(find leaf_robot_description)/urdf/leaf_robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="leaf_robot_description.ros2_control.xacro" />


    <xacro:leaf_robot_description_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
